# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or local mongodb://localhost:27017/image_crop_viewer)
# If empty in local development, an in-memory MongoDB instance will automatically initialize!
MONGODB_URI=

# Allowed Frontend Origins for CORS (comma separated, or * for permissive dev)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,*
